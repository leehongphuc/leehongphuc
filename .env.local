# CManga Local Development Environment
# Cấu hình môi trường phát triển cục bộ

# Server Configuration
PORT=8080
HOST=localhost
DEBUG=true
AUTO_RELOAD=true

# API Configuration
API_BASE_URL=http://localhost:8080/api
MOCK_API=true

# Development Features
ENABLE_CORS=true
ENABLE_LOGGING=true
ENABLE_HOT_RELOAD=false

# Performance
CACHE_STATIC_FILES=false
COMPRESS_RESPONSES=false

# Security (Development only)
DISABLE_SECURITY_HEADERS=true
ALLOW_UNSAFE_EVAL=true

# Logging Level
LOG_LEVEL=debug

# Feature Flags
ENABLE_GAME_MODULE=true
ENABLE_MANGA_MODULE=true
ENABLE_USER_SYSTEM=true
ENABLE_ANALYTICS=false