{
  "development": {
    "server": {
      "port": 8080,
      "host": "localhost",
      "autoReload": true,
      "openBrowser": true
    },
    "api": {
      "baseUrl": "http://localhost:8080/api",
      "mockData": true,
      "timeout": 5000
    },
    "features": {
      "enableCORS": true,
      "enableLogging": true,
      "enableHotReload": false,
      "enableAnalytics": false
    },
    "performance": {
      "cacheStaticFiles": false,
      "compressResponses": false,
      "minifyAssets": false
    },
    "paths": {
      "assets": "./assets",
      "css": "./assets/css",
      "js": "./assets/js",
      "images": "./assets/images"
    }
  },
  "production": {
    "server": {
      "port": 80,
      "host": "0.0.0.0",
      "autoReload": false,
      "openBrowser": false
    },
    "api": {
      "baseUrl": "https://api.cmanga.com",
      "mockData": false,
      "timeout": 10000
    },
    "features": {
      "enableCORS": false,
      "enableLogging": false,
      "enableHotReload": false,
      "enableAnalytics": true
    },
    "performance": {
      "cacheStaticFiles": true,
      "compressResponses": true,
      "minifyAssets": true
    }
  }
}