{
  "name": "cmanga",
  "version": "1.0.0",
  "description": "Nền tảng đọc truyện và Game RPG Tu Tiên",
  "main": "index.html",
  "scripts": {
    "start": "python3 server.py",
    "start:simple": "python3 -m http.server 8080",
    "start:node": "live-server --port=8080",
    "dev": "python3 server.py --port 8080",
    "dev:node": "live-server --port=8080 --open=/",
    "build": "npm run build:css && npm run build:js",
    "build:css": "postcss assets/css/main.css -o dist/assets/css/main.min.css",
    "build:js": "terser assets/js/*.js -o dist/assets/js/main.min.js",
    "lint": "eslint assets/js/*.js",
    "lint:fix": "eslint assets/js/*.js --fix",
    "format": "prettier --write \"**/*.{html,css,js,json,md}\"",
    "test": "echo \"No tests specified\" && exit 0",
    "serve": "http-server -p 8080 -o",
    "check": "python3 dev-tools.py check",
    "validate": "python3 dev-tools.py validate",
    "optimize": "python3 dev-tools.py optimize",
    "setup": "python3 dev-tools.py all"
  },
  "keywords": [
    "manga",
    "game",
    "rpg",
    "tu-tien",
    "web-app",
    "responsive",
    "vietnamese"
  ],
  "author": "CManga Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cmanga/cmanga-web.git"
  },
  "bugs": {
    "url": "https://github.com/cmanga/cmanga-web/issues"
  },
  "homepage": "https://cmanga.com",
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "postcss": "^8.4.35",
    "postcss-cli": "^11.0.0",
    "autoprefixer": "^10.4.17",
    "cssnano": "^6.0.3",
    "terser": "^5.28.1",
    "live-server": "^1.2.2",
    "http-server": "^14.1.1"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.5.1"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "postcss": {
    "plugins": {
      "autoprefixer": {},
      "cssnano": {
        "preset": "default"
      }
    }
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2021": true
    },
    "extends": [
      "eslint:recommended",
      "prettier"
    ],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "no-unused-vars": "warn",
      "no-console": "warn"
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 80,
    "tabWidth": 2,
    "useTabs": false
  }
}